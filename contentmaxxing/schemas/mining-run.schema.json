{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resumable source mining pass",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "created_at", "updated_at", "source_id", "source_sha256", "source_chars", "settings", "template", "parts"],
  "properties": {
    "id": {"type": "string", "pattern": "^mine_[a-f0-9]{12}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "source_id": {"type": "string", "pattern": "^src_[a-f0-9]{12}$"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_chars": {"type": "integer", "minimum": 1},
    "settings": {"type": "object"},
    "template": {"type": "object"},
    "parts": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "start_offset", "end_offset", "start_line", "end_line"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^task_[a-f0-9]{12}$"},
        "start_offset": {"type": "integer", "minimum": 0},
        "end_offset": {"type": "integer", "minimum": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    }}
  }
}

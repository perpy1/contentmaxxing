{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentmaxxing.local/schemas/source",
  "title": "source",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+_[a-f0-9]{12}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    },
    "consent": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "created_at",
    "updated_at",
    "title",
    "kind",
    "path",
    "sha256",
    "consent",
    "notes"
  ]
}

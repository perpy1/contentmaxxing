      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string"
    },
    "promise": {
      "type": "string"
    },
    "enemy": {
      "type": "string"
    },
    "beliefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "differentiator": {
      "type": "string"
    },
    "content_pillars": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supporting_topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platform_roles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "usernames": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }

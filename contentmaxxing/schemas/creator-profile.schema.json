    },
    "business_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expertise": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "career_history": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof_results": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strong_opinions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ownership_topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "posting_cadence": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "desired_tone": {
      "type": "string"
    },
    "writing_samples": {
      "type": "array",
      "items": {
        "type": "string"
      }

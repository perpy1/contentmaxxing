{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editorial evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "cases"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operation",
          "profile",
          "voice",
          "source",
          "brief",
          "rubric"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "operation": {
            "enum": [
              "mine",
              "draft",
              "compound"
            ]
          },
          "profile": {
            "type": "object"
          },
          "voice": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "brief": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "job": {
            "type": "string",
            "minLength": 1
          },
          "parent_body": {
            "type": "string",
            "minLength": 1
          },
          "addition": {
            "enum": [
              "context",
              "proof",
              "story",
              "format",
              "argument",
              "utility"
            ]
          },
          "rubric": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "draft"
                }
              }
            },
            "then": {
              "required": [
                "topic",
                "platform",
                "format",
                "job"
              ]
            }
          },
          {
            "if": {
              "required": [
                "parent_body"
              ],
              "properties": {
                "operation": {
                  "const": "draft"
                }
              }
            },
            "then": {
              "required": [
                "addition"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "compound"
                }
              }
            },
            "then": {
              "required": [
                "topic",
                "parent_body"
              ]
            }
          }
        ]
      }
    }
  }
}

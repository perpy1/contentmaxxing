{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-backed voice analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "observations", "unknowns", "conflicts"],
  "properties": {
    "summary": {"$ref": "#/$defs/text"},
    "observations": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dimension", "pattern", "guidance", "certainty", "platform", "medium", "evidence"],
        "properties": {
          "dimension": {"enum": ["syntax", "casing", "rhythm", "vocabulary", "humor", "certainty", "cta", "other"]},
          "pattern": {"$ref": "#/$defs/text"},
          "guidance": {"$ref": "#/$defs/text"},
          "certainty": {"enum": ["tentative", "recurring"]},
          "platform": {"type": ["string", "null"]},
          "medium": {"enum": ["writing", "speech"]},
          "evidence": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["sample_id", "quote"],
              "properties": {"sample_id": {"type": "string"}, "quote": {"$ref": "#/$defs/text"}}
            }
          }
        }
      }
    },
    "unknowns": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/text"}},
    "conflicts": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {"text": {"type": "string", "minLength": 1, "maxLength": 1500}}
}
